# Copy to .env and adjust. Never commit .env; never put a real key in this file.
#
#   cp .env.example .env

# --- Django core -------------------------------------------------------------

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Comma-separated list of hosts Django will serve. Defaults to * (allow all).
# In production set this to your real domain(s), e.g. api.example.com
DJANGO_ALLOWED_HOSTS=*

# --- Database ----------------------------------------------------------------

# Inside Docker Compose the database host is `db`.
# Running the backend directly on your machine? Use `localhost` instead:
#   DATABASE_URL=postgres://intake:intake@localhost:5432/intake
DATABASE_URL=postgres://intake:intake@db:5432/intake

# Seconds a database connection is kept alive between requests (0 = no pooling).
DB_CONN_MAX_AGE=60

# --- Authentication (JWT) ----------------------------------------------------

# Access token lifetime in minutes (default: 60).
JWT_ACCESS_MINUTES=60

# Refresh token lifetime in days (default: 7).
JWT_REFRESH_DAYS=7

# --- Cache -------------------------------------------------------------------
# Default is an in-process memory cache (fine for dev, lost on restart).
# For production set both vars to use Redis (no extra package needed on Django 4+):
#CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
#CACHE_LOCATION=redis://localhost:6379/1
#CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
#CACHE_LOCATION=

# --- AI provider -------------------------------------------------------------
# mock is the default and needs no API key: the whole app runs and every
# failure path is reachable without talking to a real model.
AI_PROVIDER=mock                 # mock | anthropic | nvidia | langchain
AI_MODEL=                        # e.g. claude-sonnet-4-6 (anthropic/langchain) or meta/llama-3.1-70b-instruct (nvidia)
AI_API_KEY=                      # never commit a real key; get NVIDIA keys at build.nvidia.com
AI_FALLBACK_TO_MOCK=False        # True: on any provider failure, silently fall back to mock

# LangChain provider — only needed when AI_PROVIDER=langchain.
# AI_API_KEY and AI_MODEL are reused; only the backend changes.
LANGCHAIN_BACKEND=anthropic      # anthropic | openai | nvidia
AI_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=5

# Mock provider behaviour. Failure modes are also reachable per item by putting
# a marker in the title, e.g. "[simulate:timeout] Missing payslip".
MOCK_AI_LATENCY_MS=800
MOCK_AI_FAILURE_MODE=none        # none | timeout | malformed | bad_enum | error

# --- Email (production only) -------------------------------------------------
# In development Django prints emails to the console; these vars are only read
# when DJANGO_DEBUG=False.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@workintake.local

# Frontend origin included in password-reset email links.
FRONTEND_URL=http://localhost:5173

# --- Optional ----------------------------------------------------------------

# Shared secret the external system sends as X-API-Key when posting work items.
# Empty means the intake endpoint is open (the default for local demos).
INTAKE_API_KEY=

# CORS — only needed when DJANGO_DEBUG=False. Comma-separated list of allowed origins.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Log level for the root logger (DEBUG | INFO | WARNING | ERROR). Default: INFO.
LOG_LEVEL=INFO
