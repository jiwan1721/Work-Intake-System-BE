# Copy to .env and adjust. Never commit .env; never put a real key in this file.
#
#   cp .env.example .env

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Inside Docker Compose the database host is `db`.
# Running the backend directly on your machine? Use `localhost` instead:
#   DATABASE_URL=postgres://intake:intake@localhost:5432/intake
DATABASE_URL=postgres://intake:intake@db:5432/intake

# --- AI provider -------------------------------------------------------------
# mock is the default and needs no API key: the whole app runs and every
# failure path is reachable without talking to a real model.
AI_PROVIDER=mock                 # mock | anthropic | nvidia
AI_MODEL=                        # e.g. claude-sonnet-5 (anthropic) or meta/llama-3.1-70b-instruct (nvidia)
AI_API_KEY=                      # never commit a real key; get NVIDIA keys at build.nvidia.com
AI_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=5

# Mock provider behaviour. Failure modes are also reachable per item by putting
# a marker in the title, e.g. "[simulate:timeout] Missing payslip".
MOCK_AI_LATENCY_MS=800
MOCK_AI_FAILURE_MODE=none        # none | timeout | malformed | bad_enum | error

# --- Optional ----------------------------------------------------------------
# Shared secret the external system sends as X-API-Key when posting work items.
# Empty means the intake endpoint is open (the default for local demos).
INTAKE_API_KEY=

# CORS — only needed when DJANGO_DEBUG=False. Comma-separated list of allowed origins.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
